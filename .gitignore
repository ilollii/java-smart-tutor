# ==============================================================================
# SENAD AI - ENTERPRISE GITIGNORE & SECURITY FILTER
# Prevents accidental leaks of credentials, secrets, tokens, and binary files.
# ==============================================================================

# 1. Environment Files & Secrets (NEVER COMMIT!)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# 3. Cloud Provider & Service Account Credentials
*credential*.json
*service-account*.json
*secret*.json
google-services.json
client_secret*.json
aws_credentials
gcloud_credentials

# 4. Java Build Outputs & Bytecode
*.class
bin/
out/
target/
build/
*.jar
*.war
*.ear

# 5. Sandbox Ephemeral Jail & Temp Directories
senad_sandbox_jail_*
/tmp/
temp/

# 6. Logs, Dumps & Diagnostics
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*
replay_pid*
*.stackdump

# 7. OS Metadata & IDE Workspace Cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
.gemini/
.system_generated/
scratch/
