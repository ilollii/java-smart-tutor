# ==============================================================================
# Senad AI Smart Tutor - Environment Configuration (.env.example)
# Copy this file to .env and configure your secret credentials.
# NEVER commit your real .env file to public version control (Git).
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# University Domain Binding
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://*.imsiu.edu.sa

# HMAC-SHA256 Token Signature Secret Key (Replace with 64-char random hex in production)
SESSION_SECRET=senad_super_secret_hmac_sha256_key_2026_imsiu_academic_portal_prod

# Google Gemini Pro / Flash API Key (Optional: Server Proxy Fallback)
GEMINI_API_KEY=

# OpenRouter AI Key (Optional fallback)
OPENROUTER_API_KEY=
